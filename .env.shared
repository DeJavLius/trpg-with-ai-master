# TARGET
DW_SITE=https://sites.google.com

# MODEL
EMBED_TEST_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_TEST_MAX_SEQ=128
# 비교 후보. ⚠️ 조직 접두를 반드시 붙인다 — hf_hub_download 는 자동으로 안 붙인다
MODEL_COMPARE_REPOS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2,BAAI/bge-m3,intfloat/multilingual-e5-large,jhgan/ko-sroberta-multitask
MODEL_LOCAL_ONLY=1

# PATH & FILE NAME
CORPORA_DUNGEONWORLD_PATH=corpora/dungeonworld/
URL_KEYWORD=/view/dwtemporary/

# None Duplicate Allow. Required Files
INDEX_FILE=index
META_FILE=meta
META_RESULT_FILE=diagnose
MODEL_COMPARE_FILE=profile
CHUNK_RESULT_FILE=chunks

# CRAWL CONFIG
DO_CRAWL=0
DO_CREATE=0
DO_DIAGNOSE=0
DO_COMPARE=1
DO_MODEL_COMPARE=1
